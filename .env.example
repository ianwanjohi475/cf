# Copy to .env and edit:  cp .env.example .env

# Password asked by the browser page. REQUIRED if LISTEN_ADDR is not 127.0.0.1.
VNC_PASSWORD=

# 127.0.0.1 = only this PC can open the phone.
# 0.0.0.0   = other devices on your network can open it (set a password!).
LISTEN_ADDR=127.0.0.1
WEB_PORT=6080

# Phone hardware. Settings below are applied when the phone is first created;
# run "./phone.sh reset" after changing them.
PHONE_RAM_MB=4096
PHONE_CORES=4
PHONE_STORAGE=16G
PHONE_WIDTH=720
PHONE_HEIGHT=1600
PHONE_DENSITY=320

# swiftshader_indirect = software graphics, works everywhere.
GPU_MODE=swiftshader_indirect
